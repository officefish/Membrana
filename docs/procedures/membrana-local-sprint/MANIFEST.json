    { "id": "open", "holder": "vesnin" },
    { "id": "cut", "holder": "vesnin" },
    { "id": "ratify", "holder": "vesnin" },
    { "id": "execute", "holder": "dynin" },
    { "id": "journal", "holder": "dynin" },
