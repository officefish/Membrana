      {
        "id": "run-ledger-trail",
        "kind": "journal",
        "path": "docs/procedure-runs/trail/2026-08-01.jsonl"
      }
    ]
  },
  "mode": "local",
  "home": {
    "kind": "none",
    "why": "инстансы живут в docs/local-sprint/<id>/ как прогоны OPEN/CLOSURE; отдельная форма дома пока не закреплена"
  }
