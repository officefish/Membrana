{
  "version": 1,
  "home": "docs/containers/strategic-docs",
  "manifest": "docs/containers/strategic-docs/workshop.manifest.json",
  "kit": null,
  "surfaceStatus": {
    "affinePublish": {
      "status": "frozen",
      "since": "2026-07-26",
      "reason": "Five Affine publish-leg repairs in one day exhausted agent time; Affine remains storage, not the editing/publishing instrument.",
      "precedent": "docs/precedents/2026-07-26-affine-editor-paradigm-impedance.md",
      "bypassFlag": "--allow-affine-frozen-publish",
      "appliesTo": [
        "strategic-docs:publish",
        "affine:import",
        "affine:sync"
      ],
      "hostRole": "storage-only",
      "doesNotFreeze": [
        "granules",
        "passports",
        "generators"
      ]
    }
  },
  "tools": [
    {
      "id": "tools",
      "verb": null,
      "zone": "workshop",
      "yarn": "yarn strategic-docs:tools",
      "script": "scripts/strategic-docs-tools.mjs",
      "doc": "docs/containers/strategic-docs/WORKSHOP.md",
      "summary": "Таблица инструментов мастерской (catalog + manifest)"
    },
    {
      "id": "generate",
      "verb": "generate",
      "zone": "workshop",
      "yarn": "yarn strategic-docs:generate --template <id>",
      "script": "scripts/strategic-docs-generate.mjs",
      "doc": "docs/containers/strategic-docs/WORKSHOP.md",
      "summary": "Сборка релиза из шаблона + pinned гранул → releases/ или experiments/"
    },
    {
      "id": "publish",
      "verb": "publish",
      "zone": "workshop",
      "yarn": "yarn strategic-docs:publish",
      "script": "scripts/strategic-docs-publish.mjs",
      "doc": "docs/containers/strategic-docs/PUBLISH.md",
      "summary": "FROZEN: Generate (опц.) + export bundle → Affine Templates и/или Releases"
    },
    {
      "id": "publish-push",
      "verb": null,
      "zone": "workshop",
      "yarn": "yarn strategic-docs:publish --push",
      "script": "scripts/lib/affine-push.mjs",
      "doc": "docs/containers/strategic-docs/PUBLISH.md",
      "summary": "FROZEN: Programmatic push via affine-cli (W3)"
    },
    {
      "id": "publish-templates",
      "verb": "publishTemplates",
      "zone": "workshop",
      "yarn": "yarn strategic-docs:publish --target templates --skip-generate",
      "script": "scripts/strategic-docs-publish.mjs",
      "doc": "docs/containers/strategic-docs/PUBLISH.md",
      "summary": "FROZEN: Export всех granules + templates в workspace Templates / namespace контейнера"
    },
    {
      "id": "publish-releases",
      "verb": "publishReleases",
      "zone": "workshop",
      "yarn": "yarn strategic-docs:publish --target releases --skip-generate",
      "script": "scripts/strategic-docs-publish.mjs",
      "doc": "docs/containers/strategic-docs/PUBLISH.md",
      "summary": "FROZEN: Export releases/ в workspace Releases (или один --template)"
    },
    {
      "id": "discover-workspaces",
      "verb": "discoverWorkspaces",
      "zone": "workshop",
      "yarn": "yarn affine:workspace:list",
      "script": "scripts/affine-workspace-list.mjs",
      "doc": "docs/containers/strategic-docs/WORKSHOP.md",
      "summary": "GraphQL: UUID workspace Templates / Releases + URLs"
    },
    {
      "id": "surface",
      "verb": null,
      "zone": "contract",
      "yarn": "—",
      "doc": "docs/containers/strategic-docs/SURFACE.md",
      "summary": "Канон routing: git SoT → Affine workspaces · namespaces · document types"
    },
    {
      "id": "granulation-design",
      "verb": null,
      "zone": "contract",
      "yarn": "—",
      "doc": "docs/containers/strategic-docs/design/README-GRANULATION-DESIGN.md",
      "summary": "Schema гранул, шаблонов, release.json, metadata v1.1"
    },
    {
      "id": "affine-sync-templates",
      "verb": null,
      "zone": "neighbor",
      "yarn": "yarn affine:sync:templates",
      "script": "scripts/affine-sync.mjs",
      "doc": "docs/containers/strategic-docs/PUBLISH.md",
      "summary": "FROZEN: Низкоуровневый batch export → Templates (prefer publish)"
    },
    {
      "id": "affine-sync-releases",
      "verb": null,
      "zone": "neighbor",
      "yarn": "yarn affine:sync:releases",
      "script": "scripts/affine-sync.mjs",
      "doc": "docs/containers/strategic-docs/PUBLISH.md",
      "summary": "FROZEN: Низкоуровневый batch export → Releases (prefer publish)"
    }
  ]
}
