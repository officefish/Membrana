{
  "name": "@membrana/plugin-contracts",
  "version": "0.1.0",
  "description": "Словарь серверной плагинности Membrana: манифест, роды, дома крепления, поводы, адрес и записи прогона. Framework-нейтральный — ни Nest, ни Mongo внутри; office и media зависят от него, не наоборот (M1_VERDICT, #1961).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist .turbo .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
