generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceKind {
  microphone
  antenna
  other
}

enum CollectionKind {
  buffer
  user
  system
}

enum SampleLabel {
  drone
  not_drone
  unlabeled
}

enum SampleSource {
  mic_recording
  disk_import
  synthetic
  move
  catalog
}

enum AudioFormat {
  wav
  mp3
  flac
  ogg
}

enum NodeKeyAudience {
  node
  client
}

model Device {
  id                      String          @id @default(uuid()) @db.Uuid
  name                    String
  kind                    DeviceKind
  /** Cabinet membrane that owns this field device (MP4 scope). */
  membraneId              String?         @db.Uuid
  /** Per-device limits copied from membrane tariff at pair/register; env fallback when null. */
  userStorageQuotaBytes   BigInt?
  bufferQuotaBytes        BigInt?
  datasetCatalogId        String?
  /** Max editable device-board workspaces (U10 tariff axis; STE v1). */
  maxUserWorkspaces       Int?
  createdAt               DateTime        @default(now())
  collections             Collection[]
  samples                 Sample[]
  trendTemplates          TrendTemplate[]
  deviceScenario          DeviceScenario?
  deviceWorkspaces        DeviceWorkspace[]
  /** Ключи полевого узла (ADR-0027 Р3): отзываемый секрет только на ручки узла своего устройства. */
  nodeKeys                NodeKey[]
  /** Active user workspace id for device-board multi-slot persist (U10 W5). */
  activeWorkspaceId       String?

  @@index([membraneId])
}

/// Ключ полевого узла (ADR-0027, b2 firebat-node-device): отдельная сущность жизненного цикла
/// выдать · сменить · отозвать. Хранится ТОЛЬКО sha256-хеш сырого ключа; сырой ключ отдаётся один раз
/// при выдаче. Ключ ≠ nodeId наблюдения: секрет не попадает в данные записи.
model NodeKey {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @db.Uuid
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Кто несёт ключ: фоновый узел (`node`) или интерактивный клиент парринга (`client`).
  audience   NodeKeyAudience @default(node)
  /// sha256(raw) в hex — сравнение timingSafeEqual, сырой ключ на сервере не хранится.
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([deviceId, revokedAt])
  @@index([deviceId, audience, revokedAt])
}

model DeviceWorkspace {
  deviceId    String   @db.Uuid
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  payload     Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@id([deviceId, workspaceId])
  @@index([deviceId])
}

model DeviceScenario {
  deviceId  String   @id @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  payload   Json
  updatedAt DateTime @updatedAt
}

model Collection {
  id        String
  deviceId  String         @db.Uuid
  device    Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  kind      CollectionKind
  systemKey String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  samples   Sample[]

  @@id([deviceId, id])
  @@index([deviceId])
}

model Sample {
  id           String       @id @default(uuid()) @db.Uuid
  deviceId     String       @db.Uuid
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection   @relation(fields: [deviceId, collectionId], references: [deviceId, id], onDelete: Cascade)
  title        String
  class        String
  label        SampleLabel
  source       SampleSource
  durationSec  Float
  sampleRate   Int
  channels     Int
  audioFormat  AudioFormat
  contentType  String
  sizeBytes    Int
  storageRef   String
  notes        String?
  createdAt    DateTime     @default(now())

  @@unique([deviceId, collectionId, title])
  @@index([deviceId])
  @@index([deviceId, collectionId])
}

model TrendTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key       String
  payload   Json
  updatedAt DateTime @updatedAt

  @@unique([deviceId, key])
  @@index([deviceId])
}

/// Секрет ключа треков мембраны (#2271, вердикт M3 заседания `library-open-api`).
///
/// ОДНА ЗАПИСЬ НА МЕМБРАНУ — и это держит СХЕМА, а не порядок вызовов. Ревью #2267 назвало
/// прямо: без уникальности `createIfAbsent` опирается на очерёдность, и параллельная первая
/// выдача заводит ключ дважды. Второй секрет затирает первый, ссылка приходит с вердиктом
/// `tampered` — то есть система сообщает о ПОДДЕЛКЕ там, где тела ключа никто не трогал.
/// Гонку нашёл зуб ротации в блоке `key-ttl`; здесь она закрывается на уровне БД.
///
/// Поштучного отзыва у предъявительского ключа нет по конструкции: гасит только ротация,
/// поднимающая `generation` и обесценивающая ВСЕ ссылки мембраны разом.
model TrackKeySecret {
  id         String   @id @default(uuid()) @db.Uuid
  membraneId String   @db.Uuid
  /// Поколение ключа. Ротация увеличивает его; проверка сверяет ПЕРВЫМ вопросом, поэтому
  /// ротация гасит и невыдохшие ссылки, а не ждёт истечения срока.
  generation Int      @default(1)
  /// Сырой секрет подписи. В логи не пишется и наружу не отдаётся ни при каком ответе.
  secret     String
  rotatedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([membraneId])
}

/// Настройка срока ключа треков — мембранный выключатель (вердикт M3).
///
/// МАСШТАБ — МЕМБРАНА, и приёмный лоток под него ПОПАДАЕТ: одно движение человека меняет срок
/// для всех наборов и всех треков. Отдельной области управления у лотка нет, и это названная
/// цена, а не упущение: сняв срок ради разобранных наборов, человек снимает его и с записей двора.
///
/// Три состояния, а не два. `mode = lifted` — единственный законный источник «срока нет»;
/// пустая, повреждённая или прошедшая величина даёт fail-closed на `DEFAULT_TRACK_KEY_TTL`.
/// Снятие обязано нести подпись: `liftedAt`/`liftedBy` без значения — порча, а не снятие.
model TrackKeyTtlSetting {
  id         String    @id @default(uuid()) @db.Uuid
  membraneId String    @db.Uuid
  /// `default` | `seconds` | `lifted` — словарь блока `key-ttl`, строкой ради миграций.
  mode       String    @default("default")
  seconds    Int?
  liftedAt   DateTime?
  liftedBy   String?
  updatedAt  DateTime  @updatedAt

  @@unique([membraneId])
}
