generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceKind {
  microphone
  antenna
  other
}

enum CollectionKind {
  buffer
  user
  system
}

enum SampleLabel {
  drone
  not_drone
  unlabeled
}

enum SampleSource {
  mic_recording
  disk_import
  synthetic
  move
  catalog
}

enum AudioFormat {
  wav
  mp3
  flac
  ogg
}

enum NodeKeyAudience {
  node
  client
}

/// Политика переполнения буфера (#2308, вердикт M1 заседания `buffer-full-stop`).
///
/// ДВА ЗНАЧЕНИЯ, И ОБА НАЗВАНЫ. Легаси `auto-cleanup` клиента в тип НЕ входит: Postgres отвергает
/// неизвестное значение сам, и вернуть старую автоочистку через базу нельзя ни при каком коде.
/// Умолчание — `stop` (слово владельца 06.09): буфер — архив вещдоков, а не мусорная корзина.
enum BufferPolicyMode {
  stop
  smart_cleanup
}

model Device {
  id                      String          @id @default(uuid()) @db.Uuid
  name                    String
  kind                    DeviceKind
  /** Cabinet membrane that owns this field device (MP4 scope). */
  membraneId              String?         @db.Uuid
  /** Per-device limits copied from membrane tariff at pair/register; env fallback when null. */
  userStorageQuotaBytes   BigInt?
  bufferQuotaBytes        BigInt?
  datasetCatalogId        String?
  /** Cabinet tariff contract version copied with quota context. */
  tariffContractVersion   Int             @default(1)
  /** Max editable device-board workspaces (U10 tariff axis; STE v1). */
  maxUserWorkspaces       Int?
  createdAt               DateTime        @default(now())
  collections             Collection[]
  samples                 Sample[]
  trendTemplates          TrendTemplate[]
  deviceScenario          DeviceScenario?
  deviceWorkspaces        DeviceWorkspace[]
  /** Ключи полевого узла (ADR-0027 Р3): отзываемый секрет только на ручки узла своего устройства. */
  nodeKeys                NodeKey[]
  /// Архив понижения (ADR-0031, #2587 b2): партии и перенесённые строки проб. Каскада от прибора
  /// НЕТ (#2632 g1a, Т3): обе связи — `Restrict`, прибор с архивом не удаляется молча.
  downgradeArchiveBatches  DowngradeArchiveBatch[]
  downgradeArchivedSamples DowngradeArchivedSample[]
  /** Active user workspace id for device-board multi-slot persist (U10 W5). */
  activeWorkspaceId       String?
  /// Политика переполнения (#2308, M1): carrier рантайма — прибор читает ЭТО через `/quota`.
  /// Origin команды — кабинет, разносит тем же PATCH `/membrane`, что квоты. NOT NULL после
  /// backfill: все приборы, жившие до миграции, — `stop`.
  bufferPolicy            BufferPolicyMode @default(stop)
  /// Каркас параметров умной очистки (порог, критерий отбора, защита вещдоков) — БЕЗ алгоритма
  /// (T12). Null при `stop`. Неполный набор на пути чтения даёт `stop`, а не «умную» с дырой.
  bufferPolicyParams      Json?

  @@index([membraneId])
}

/// Ключ полевого узла (ADR-0027, b2 firebat-node-device): отдельная сущность жизненного цикла
/// выдать · сменить · отозвать. Хранится ТОЛЬКО sha256-хеш сырого ключа; сырой ключ отдаётся один раз
/// при выдаче. Ключ ≠ nodeId наблюдения: секрет не попадает в данные записи.
model NodeKey {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @db.Uuid
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Кто несёт ключ: фоновый узел (`node`) или интерактивный клиент парринга (`client`).
  audience   NodeKeyAudience @default(node)
  /// sha256(raw) в hex — сравнение timingSafeEqual, сырой ключ на сервере не хранится.
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([deviceId, revokedAt])
  @@index([deviceId, audience, revokedAt])
}

model DeviceWorkspace {
  deviceId    String   @db.Uuid
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  payload     Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@id([deviceId, workspaceId])
  @@index([deviceId])
}

model DeviceScenario {
  deviceId  String   @id @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  payload   Json
  updatedAt DateTime @updatedAt
}

model Collection {
  id        String
  deviceId  String         @db.Uuid
  device    Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  kind      CollectionKind
  systemKey String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  samples   Sample[]

  @@id([deviceId, id])
  @@index([deviceId])
}

model Sample {
  id           String       @id @default(uuid()) @db.Uuid
  deviceId     String       @db.Uuid
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection   @relation(fields: [deviceId, collectionId], references: [deviceId, id], onDelete: Cascade)
  title        String
  class        String
  label        SampleLabel
  source       SampleSource
  durationSec  Float
  sampleRate   Int
  channels     Int
  audioFormat  AudioFormat
  contentType  String
  sizeBytes    Int
  storageRef   String
  notes        String?
  createdAt    DateTime     @default(now())

  @@unique([deviceId, collectionId, title])
  @@index([deviceId])
  @@index([deviceId, collectionId])
}

model TrendTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key       String
  payload   Json
  updatedAt DateTime @updatedAt

  @@unique([deviceId, key])
  @@index([deviceId])
}

/// Секрет ключа треков мембраны (#2271, вердикт M3 заседания `library-open-api`).
///
/// ОДНА ЗАПИСЬ НА МЕМБРАНУ — и это держит СХЕМА, а не порядок вызовов. Ревью #2267 назвало
/// прямо: без уникальности `createIfAbsent` опирается на очерёдность, и параллельная первая
/// выдача заводит ключ дважды. Второй секрет затирает первый, ссылка приходит с вердиктом
/// `tampered` — то есть система сообщает о ПОДДЕЛКЕ там, где тела ключа никто не трогал.
/// Гонку нашёл зуб ротации в блоке `key-ttl`; здесь она закрывается на уровне БД.
///
/// Поштучного отзыва у предъявительского ключа нет по конструкции: гасит только ротация,
/// поднимающая `generation` и обесценивающая ВСЕ ссылки мембраны разом.
model TrackKeySecret {
  id         String   @id @default(uuid()) @db.Uuid
  membraneId String   @db.Uuid
  /// Поколение ключа. Ротация увеличивает его; проверка сверяет ПЕРВЫМ вопросом, поэтому
  /// ротация гасит и невыдохшие ссылки, а не ждёт истечения срока.
  generation Int      @default(1)
  /// Сырой секрет подписи. В логи не пишется и наружу не отдаётся ни при каком ответе.
  secret     String
  rotatedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([membraneId])
}

/// Настройка срока ключа треков — мембранный выключатель (вердикт M3).
///
/// МАСШТАБ — МЕМБРАНА, и приёмный лоток под него ПОПАДАЕТ: одно движение человека меняет срок
/// для всех наборов и всех треков. Отдельной области управления у лотка нет, и это названная
/// цена, а не упущение: сняв срок ради разобранных наборов, человек снимает его и с записей двора.
///
/// Три состояния, а не два. `mode = lifted` — единственный законный источник «срока нет»;
/// пустая, повреждённая или прошедшая величина даёт fail-closed на `DEFAULT_TRACK_KEY_TTL`.
/// Снятие обязано нести подпись: `liftedAt`/`liftedBy` без значения — порча, а не снятие.
model TrackKeyTtlSetting {
  id         String    @id @default(uuid()) @db.Uuid
  membraneId String    @db.Uuid
  /// `default` | `seconds` | `lifted` — словарь блока `key-ttl`, строкой ради миграций.
  mode       String    @default("default")
  seconds    Int?
  liftedAt   DateTime?
  liftedBy   String?
  updatedAt  DateTime  @updatedAt

  @@unique([membraneId])
}

/// Состояние партии архива понижения (ADR-0031). Закрытый список: `failed` — частичный перенос,
/// уборка по сроку его не трогает, хвост подбирает следующая заморозка.
enum DowngradeArchiveState {
  frozen
  restored
  deleted
  failed
}

/// Партия архива понижения (#2587 b2; ADR-0031, решения 2 и 4) — единица заморозки, возврата и
/// удаления. Отдельная таблица, а НЕ пометка на `Sample`: `getQuota`, списки и витрины читают
/// `Sample` и об архиве не знают. `expiresAt` — СНИМОК `frozenAt + retentionDays` суток: смена срока
/// на мембране старые партии не пересчитывает. Идемпотентность freeze держит `@@unique([deviceId,
/// planDigest])`, а не порядок вызовов. Не путать с тарифной ячейкой `storage.cold`:
/// downgrade-archive ≠ tariff-cold.
///
/// Связь с прибором — `Restrict` (#2632 g1a; Т3 «удаление прибора запрещено, пока есть архив»):
/// удаление `Device` с партией получает отказ БД, а не немой каскад архива вместе с файлами-сиротами.
/// Партия после уборки остаётся следом (`state = deleted`), поэтому отказ держит и такие приборы:
/// глагола удаления прибора в media нет, будущий глагол обязан разобраться с архивом явно.
model DowngradeArchiveBatch {
  id            String                    @id @default(uuid()) @db.Uuid
  deviceId      String                    @db.Uuid
  device        Device                    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  membraneId    String                    @db.Uuid
  /// Закрытый словарь оснований; v1 — только `tariff_downgrade`.
  reason        String                    @default("tariff_downgrade")
  fromTariffId  String
  toTariffId    String
  /// Режим chart-list, по которому отбирали живое.
  criterion     String
  /// Хеш подтверждённого предпросмотра.
  planDigest    String
  /// Срок в сутках — снимок от кабинета на момент заморозки.
  retentionDays Int
  frozenAt      DateTime                  @default(now())
  expiresAt     DateTime
  state         DowngradeArchiveState     @default(frozen)
  restoredAt    DateTime?
  deletedAt     DateTime?
  /// Вещдок post-condition: сумма живого после заморозки и сумма ушедшего в партию.
  keptBytes     BigInt
  frozenBytes   BigInt
  samples       DowngradeArchivedSample[]
  /// Задания уборщика по этой партии (#2632) — журнал доказательства удаления.
  purgeJobs     ColdArchivePurgeJob[]

  @@unique([deviceId, planDigest])
  @@index([expiresAt])
  @@index([deviceId, state])
}

/// Строка пробы, перенесённая из `Sample` ЦЕЛИКОМ под ТЕМ ЖЕ `id` (возврат восстанавливает прежний
/// адрес). Файл блоба остаётся на месте (`storageRef`). Связь с партией — `NoAction`: явное
/// удаление живой партии получает отказ (выбрано в #2587 b2, когда от `Device` шёл каскад; после
/// #2632 g1a каскада нет, `NoAction` оставлен как есть — смысл «партия остаётся следом» тот же).
/// Связь с прибором — `Restrict` (#2632 g1a, Т3), как у партии.
model DowngradeArchivedSample {
  id           String                @id @db.Uuid
  batchId      String                @db.Uuid
  batch        DowngradeArchiveBatch @relation(fields: [batchId], references: [id], onDelete: NoAction)
  deviceId     String                @db.Uuid
  device       Device                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  collectionId String
  title        String
  class        String
  label        SampleLabel
  source       SampleSource
  durationSec  Float
  sampleRate   Int
  channels     Int
  audioFormat  AudioFormat
  contentType  String
  sizeBytes    Int
  storageRef   String
  notes        String?
  createdAt    DateTime
  /// Ранг режима на момент заморозки; `null` — неизмеримая (ADR-0031, решение 6).
  modeRank     Int?
  archivedAt   DateTime              @default(now())

  @@index([batchId])
  @@index([deviceId])
}

// ─── Журнал уборщика холодного архива (#2632 g1a; консилиум archive-gc-journal-2026-10-08, вердикт 1) ───
// purge-journal ≠ downgrade-archive: архив — ЧТО заморожено, журнал — ЧТО и КАК уборщик удалил.
// Литералы enum'ов чеканит `src/modules/downgrade-archive/purge-journal.vocabulary.ts`; зуб
// `purge-journal.schema.test.ts` держит равенство словаря, схемы и миграции.

/// Кто разбудил прогон: ежечасный cron office, панель, ручной вызов.
enum ColdArchivePurgeTrigger {
  cron
  panel
  manual
}

/// Режим прогона: `dry_run` пишет прогон и задания со снимком и исходом «было бы», без rm.
enum ColdArchivePurgeMode {
  dry_run
  live
}

/// Исход прогона. `abandoned` — оборван рестартом; помечается на старте следующего прогона.
enum ColdArchivePurgeRunStatus {
  running
  succeeded
  failed
  abandoned
}

/// Предмет задания: партия целиком или осиротевший файл (долг между прогонами).
enum ColdArchivePurgeTarget {
  batch
  orphan_blob
}

/// Состояние задания. `dead_letter` — попытки исчерпаны, долг виден в панели (Т2).
enum ColdArchivePurgeJobStatus {
  pending
  claimed
  succeeded
  retry
  dead_letter
}

/// Прогон уборщика — пишется ВСЕГДА, когда уборка включена, в том числе пустой (вердикт 5):
/// пустой прогон = строка `succeeded` с нулями. Снимки флагов — что было в office на момент пуска.
model ColdArchivePurgeRun {
  id              String                    @id @default(uuid()) @db.Uuid
  trigger         ColdArchivePurgeTrigger
  mode            ColdArchivePurgeMode
  status          ColdArchivePurgeRunStatus @default(running)
  startedAt       DateTime                  @default(now())
  finishedAt      DateTime?
  enabledSnapshot Boolean
  dryRunSnapshot  Boolean
  jobsTotal       Int                       @default(0)
  jobsSucceeded   Int                       @default(0)
  jobsFailed      Int                       @default(0)
  jobsDeadLetter  Int                       @default(0)
  bytesFreed      BigInt                    @default(0)
  errorSummary    String?
  jobs            ColdArchivePurgeJob[]

  /// Пульс (g4/g5b): последний завершённый и последний успешный прогон.
  @@index([status, finishedAt])
  @@index([startedAt])
}

/// Задание прогона: партия (`batch`) или осиротевший файл (`orphan_blob`). `storageRefs` — СНИМОК путей
/// ДО `markPurged` (после него строк архива уже нет). `outcomes` — по каждому пути
/// `{ beforeExists, afterExists, action: removed | already_absent | failed }`. Захват — по лизу
/// (`leaseUntil`), повтор — по `nextAttemptAt`. Партия — ссылка `NoAction`: партии не удаляются,
/// уборка лишь переводит их в `deleted`.
model ColdArchivePurgeJob {
  id            String                    @id @default(uuid()) @db.Uuid
  runId         String                    @db.Uuid
  run           ColdArchivePurgeRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  targetType    ColdArchivePurgeTarget
  batchId       String?                   @db.Uuid
  batch         DowngradeArchiveBatch?    @relation(fields: [batchId], references: [id], onDelete: NoAction)
  /// Снимок прибора партии; не внешний ключ — журнал не держит прибор.
  deviceId      String?                   @db.Uuid
  storageRefs   String[]
  status        ColdArchivePurgeJobStatus @default(pending)
  attempt       Int                       @default(0)
  nextAttemptAt DateTime?
  leaseUntil    DateTime?
  outcomes      Json                      @default("{}")
  bytesFreed    BigInt                    @default(0)
  lastError     String?

  /// Одна партия — одно задание в прогоне; повтор той же партии в прогоне получает отказ БД.
  /// `orphan_blob` идёт с `batchId = NULL` (Postgres считает NULL различными) и различается по
  /// `storageRefs`, не по партии; дедупликация долга сирот — зуб исполнителя (g3b), не схемы.
  @@unique([runId, batchId])
  /// Выборка долга: `status in (pending, retry)` и `nextAttemptAt <= now`.
  @@index([status, nextAttemptAt])
  @@index([batchId])
}
