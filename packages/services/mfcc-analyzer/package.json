{
  "name": "@membrana/mfcc-analyzer-service",
  "version": "0.1.0",
  "description": "MFCC-ядро: свёртка готовых кадров в кепстральные коэффициенты. Библиотека спрятана за периметром core/; кадрирование — предмет audio-engine-service.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist .turbo .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
