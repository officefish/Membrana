PORT=3000
NODE_ENV=development
LOG_LEVEL=info

API_INTERNAL_TOKEN=change-me

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=

GITHUB_TOKEN=
GITHUB_OWNER=officefish
GITHUB_REPO=Membrana

# Intern T3 research digest (yarn office:research-digest) — ключ в корневом .env тоже ок
# PERPLEXITY_API_KEY=
# OFFICE_DIGEST_TOPIC=acoustic detection of small UAVs / drones

# Опционально, если Anthropic из терминала без системного VPN:
# HTTPS_PROXY=http://127.0.0.1:7890

# Telegram ally reports (#428): дайджесты ритуалов в приватную группу союзников
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLY_CHAT_ID=

# Night Hunt (optional scheduled jobs → GitHub PR via OpenRouter)
# NIGHT_HUNT_ENABLED=true
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# NIGHT_HUNT_BASE_BRANCH=main

# DeepSeek direct — fallback нарратива ночных агентов (ADR 0005), без прокси
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Panel auth (OP2, эпик #438) — stateless-авторизация panel.mmbrn.tech
# PANEL_SESSION_SECRET=          # обязателен для входа; подпись cookie/state
# PANEL_INVITE_SECRET=           # опционально (fallback = PANEL_SESSION_SECRET)
# PANEL_GITHUB_CLIENT_ID=        # GitHub OAuth App (operator/owner)
# PANEL_GITHUB_CLIENT_SECRET=
# PANEL_GITHUB_ALLOWLIST={"github_user_id":"owner"}
# PANEL_PUBLIC_URL=https://panel.mmbrn.tech
# PANEL_RATE_LIMIT_PER_MIN=120     # rate-limit панельных ручек на клиента (OP5)

# Archivarius (#1330): локально можно оставить пустым (in-memory), docker-compose дает MongoDB.
# ARCHIVARIUS_MONGO_URI=mongodb://archivarius:change-me@localhost:27017/membrana_archivarius?authSource=admin
# ARCHIVARIUS_MONGO_DB=membrana_archivarius

# Уборка холодного архива понижения тарифа (#2588 b6, ADR-0031 п.4; уборщик с журналом — #2632).
# Ежечасный cron office (минута 0, UTC) → POST {MEDIA_API_URL}/v1/internal/downgrade-archive/purge-expired.
# Нужен MEDIA_API_URL (без него исход media-not-configured, удалений нет); ключ — MEDIA_API_TOKEN,
# не задан — берётся API_INTERNAL_TOKEN.
#
# Два флага, умолчания безопасны:
#   COLD_ARCHIVE_SWEEP_ENABLED  — выкл (умолчание) = тишина: media не зовём вовсе.
#                                 Включено только значением true или 1; всё прочее = выключено.
#   COLD_ARCHIVE_SWEEP_DRY_RUN  — вкл (умолчание) = только показать кандидатов, ничего не удалять.
#                                 Выключено только значением false или 0; всё прочее (и опечатка) = dry-run.
#
# Порядок включения — строго по шагам, не перепрыгивать:
#   1. ENABLED=false (DRY_RUN любой) — исходное состояние: уборка спит.
#   2. ENABLED=true, DRY_RUN=true     — пробные прогоны: смотреть, кого уборка удалила бы.
#   3. DRY_RUN=false                  — боевая уборка. ТОЛЬКО словом владельца, после успешных
#                                       пробных прогонов и живой приёмки (#2632, блок g7).
# Откат мгновенный: ENABLED=false (или DRY_RUN=true) и перезапуск office.
#
# ВНИМАНИЕ: боевая уборка НЕОБРАТИМА. Партии архива с истёкшим сроком удаляются вместе с файлами
# записей на диске media; возврат тарифа их не вернёт. Откат флагов останавливает только СЛЕДУЮЩИЕ
# удаления, не уже сделанные. Перед шагом 3 — свежая копия базы и тома файлов media
# (docs/deploy/BACKGROUND_MEDIA_DEPLOY.md, раздел 7).
# Переключателя боевого режима в панели нет (вердикт 8 консилиума #2632) — только этот файл.
COLD_ARCHIVE_SWEEP_ENABLED=false
COLD_ARCHIVE_SWEEP_DRY_RUN=true
