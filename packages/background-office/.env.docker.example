# Docker Compose stack (@membrana/background-office)
# cp .env.docker.example .env.docker
# yarn office:docker:up

# Host port (container listens on 3000)
OFFICE_PORT=3000

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# API auth — same value clients send as X-Membrana-Token
API_INTERNAL_TOKEN=change-me-in-production

# Required integrations — placeholders allow /health without real keys.
# Replace with real values for POST /v1/claude/ask smoke.
ANTHROPIC_API_KEY=docker-placeholder-not-for-api
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

LINEAR_API_KEY=docker-placeholder
LINEAR_WEBHOOK_SECRET=docker-placeholder

GITHUB_TOKEN=docker-placeholder
GITHUB_OWNER=officefish
GITHUB_REPO=Membrana

# Dreams v2 (M5): hourly cron + digest route
DREAMS_ENABLED=true
DREAMS_VOLUME_PATH=/var/lib/membrana-dreams

# Archivarius (#1330): локальный/staging Mongo в составе office-compose.
# #2580: пароль базы и URI подставляет compose ИНТЕРПОЛЯЦИЕЙ (оболочка / .env проекта /
# --env-file), а не из этого файла: ключ `environment:` в compose перекрывает env_file.
# Локально без них действует умолчание базового compose; прод-оверлей умолчаний не
# держит — пароль и оба URI обязательны в /etc/membrana/office.env
# (deploy/generate-office-env.sh пишет их сам, одним паролем).
ARCHIVARIUS_MONGO_USERNAME=archivarius
ARCHIVARIUS_MONGO_PASSWORD=change-me-before-deploy
ARCHIVARIUS_MONGO_URI=mongodb://archivarius:change-me-before-deploy@archivarius-mongo:27017/membrana_archivarius?authSource=admin
ARCHIVARIUS_MONGO_DB=membrana_archivarius
TASK_ARCHIVE_MONGO_URI=mongodb://archivarius:change-me-before-deploy@archivarius-mongo:27017/membrana_task_archive?authSource=admin
TASK_ARCHIVE_MONGO_DB=membrana_task_archive

# Кабинет (#2588 b3): служебная дверь /v1/internal/office/* — список мембран и срок холодного архива.
# Пара опциональна и без умолчаний в коде: не задана → раздел «Пользователи кабинета» отвечает 503.
# CABINET_OFFICE_TOKEN — тот же ключ, что в env кабинета (отдельный от API_INTERNAL_TOKEN).
# CABINET_API_URL=https://cabinet.example
# CABINET_OFFICE_TOKEN=docker-placeholder

# Уборка холодного архива понижения (#2588 b6): ежечасный cron → media purge-expired по MEDIA_API_URL/MEDIA_API_TOKEN.
# Выключено (умолчание) = media не зовём вовсе. DRY_RUN=true (умолчание) = только показать кандидатов.
# Боевая уборка — только при обоих явно: ENABLED=true и DRY_RUN=false. Включать после живой приёмки (b7).
COLD_ARCHIVE_SWEEP_ENABLED=false
COLD_ARCHIVE_SWEEP_DRY_RUN=true
