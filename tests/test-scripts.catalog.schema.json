{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrana.local/tests/test-scripts.catalog.schema.json",
  "title": "Membrana script test catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "discovery", "groups", "skips", "setups"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "suffix", "prune"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "suffix": { "type": "string", "minLength": 1 },
        "prune": { "type": "array", "items": { "type": "string" } }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string" },
          "fallback": { "type": "boolean" }
        }
      }
    },
    "skips": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "setups": { "type": "object" }
  }
}
