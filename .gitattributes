# Нормализация переводов строк (DR0 deploy-pipeline-refactor).
# Цель: убрать CRLF-шум, который маскировал недокоммиченные файлы при деплое.
# Текст по умолчанию нормализуется к LF в репозитории.
* text=auto eol=lf

# Явно текстовые исходники — всегда LF.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf
*.env   text eol=lf
*.prisma text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-скрипты — CRLF (иначе ломаются).
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Бинарные ассеты — без нормализации.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.flac  binary
*.zip   binary
*.gz    binary

# Реестр задач: карточки вставляются в ГОЛОВУ, поэтому две ветки почти всегда
# конфликтуют на одних строках (10 эпизодов ручного разбора за 12–15.07).
# Драйвер сливает трёхсторонне и НЕ угадывает: правку обеих сторон отдаёт человеку.
# Регистрируется `yarn prepare` (git config merge.registry-union.driver).
docs/tasks/registry.json merge=registry-union

# README реестра — генерируемый (yarn task:sync-readme). Сливать его текстом
# бессмысленно: после мёржа он пересобирается из registry.json.
docs/tasks/README.md merge=ours

# ── Append-only журналы: союзное слияние (#2096) ────────────────────────────────
# ПОЧЕМУ. В журналы пишут ВСЕ сессии, и потому они конфликтуют у каждого. 23.08 эта
# беда стоила двум сессиям по четыре круга на PR, где не менялось ни строки предмета;
# утренний PR ритуала влился с пятого. Сведение всякий раз было одним движением: взять
# обе стороны, склеить, не потерять строк — ровно то, что делает `union`.
#
# ВСТРОЕННЫЙ `union`, А НЕ `registry-union`. Тот — семантический драйвер JSON-объекта:
# его ценность в ОТКАЗЕ, когда обе стороны правят одну карточку. У ленты, где записи
# только дописываются и ни одна не отменяет другую, такого случая по построению нет.
# Плюс `union` встроен в git и работает БЕЗ `yarn prepare` — в дереве без установки
# правило не молчит.
#
# ПРАВИЛО ПО СОГЛАШЕНИЮ, НЕ ПО СПИСКУ. Перечисление файлов отстаёт от жизни: билет
# назвал три класса, разведка нашла четвёртый (`docs/sprint/cut/trail`). Соглашение:
# append-only журнал живёт в каталоге `trail/` или `op-log/`. Новый журнал по этому
# имени попадает под правило сам; отступивший от имени ловит зуб `journals:verify`.
#
# ЧТО ПОД СОЮЗ НЕ ИДЁТ: снимки состояния, реестры с полями, конфигурация — всё, где
# важно ПОСЛЕДНЕЕ значение, а не сумма строк.
**/trail/**/*.jsonl merge=union
**/op-log/**/*.jsonl merge=union

# Фикстуры зубов лежат в тех же каталогах, но журналами НЕ являются: у них важно
# последнее значение. Исключение ТОЛЬКО через `!merge` (unspecified — обычное
# трёхстороннее слияние). Писать `-merge` нельзя: git читает это как «unset», а для
# слияния unset значит «молча взять свою сторону» — то есть ровно потерю чужих строк,
# от которой правило и заводится. Проверено опытом, не памятью.
**/fixtures/**/*.jsonl !merge

# Вторая ось соглашения — ИМЯ файла: журнал, живущий вне `trail/` и `op-log/`, объявляет
# себя суффиксом. Замер 23.08 нашёл двоих: `docs/audit/one-shot-trail.jsonl` и
# `docs/comms/sent-log.jsonl`. Новый `*-log.jsonl` попадёт под правило сам.
**/*-trail.jsonl merge=union
**/*-log.jsonl merge=union

# Журнал, чьё имя соглашению не отвечает, а переименование дороже пользы: реестр вещдоков
# только дописывается (замер: +32 −0). Список исключений остаётся честным лишь потому, что
# зуб `journals:verify` замечает всякий новый журнал мимо соглашения.
docs/evidence/registry.jsonl merge=union
docs/bridge/debt-ledger.jsonl merge=union
docs/workflows/examples.jsonl merge=union

# Вторая очередь #2096: inventory docs/**/*.jsonl, где append-only видно не из имени.
docs/audit/network/analysis/**/*.jsonl merge=union
docs/local-sprint/**/*.jsonl merge=union
docs/truth/**/*.jsonl merge=union
docs/local-sprint/**/fixtures/**/*.jsonl !merge

# ── Лента снимков сети: СЕМАНТИЧЕСКИЙ драйвер, а не союз (10.09) ───────────────
# Она попала во вторую очередь #2096 по форме (append-only .jsonl), и это была ошибка
# адреса: правило выше само говорит, что под союз НЕ идут снимки состояния. Лента —
# ряд ЗАМЕРОВ, а не журнал событий; две ветки, померившие сеть в один момент, пишут про
# ОДИН момент две разные строки, и союз склеивает обе — точный повтор момента плюс
# перепутанный порядок. Цена 09.09: четыре ручных разведения, красный прогон, отказ ревью.
# Конфликтует лента у ЛЮБЫХ двух веток не по своей вине: зуб network:tooth требует снимок
# свежее 48 часов перед push, поэтому его пишет каждая ветка. Требование свежести оставлено
# как есть — оно держит «воспоминание не выдаёт себя за факт»; чинится применённое не по
# адресу правило слияния. Драйвер перегенерирует ленту: снимает двойников по паре
# «момент+машина» и восстанавливает порядок времени.
# Регистрируется `yarn prepare`; в дереве без установки драйвер не зарегистрирован, и там
# будет честный конфликт вместо молчаливого дубля — это лучше, чем тихая порча ряда.
docs/network/history/**/*.jsonl merge=network-history

# Названное исключение: memory/archive — смешанный архив, часть файлов переписывается,
# значит порядок/последнее значение там важнее союзного сложения строк.
docs/virtual-team/memory/archive/*.jsonl !merge
