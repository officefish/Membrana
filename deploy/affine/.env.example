# Template for /opt/membrana-affine/.env on office VDS.
# Real secrets stay on the host — never commit a filled copy.
# Installer: node scripts/_ssh-affine-install.mjs (yarn affine:install)

# select a revision to deploy, available values: stable, beta, canary
AFFINE_REVISION=stable

# Host port mapped to the AFFiNE server (bound to 127.0.0.1 in compose.yml)
PORT=3010

# Public URL used for outgoing links (required for strategy.mmbrn.tech)
AFFINE_SERVER_EXTERNAL_URL=https://strategy.mmbrn.tech

# Operator import (root .env on dev machine — NOT on VDS):
# AFFINE_EMAIL=feedback@mmbrn.ru
# AFFINE_ADMIN_PASSWORD=…
# AFFINE_PASSWORD=…          # alias for admin password on dev machine
# AFFINE_API_TOKEN=…         # optional; after Settings → Access tokens in UI
# AFFINE_BASE_URL=https://strategy.mmbrn.tech
# AFFINE_WORKSPACE_TEMPLATES_ID=…   # yarn affine:workspace:list after creating «Templates»
# AFFINE_WORKSPACE_RELEASES_ID=…    # yarn affine:workspace:list after creating «Releases»
# AFFINE_WORKSPACE_ID=…             # optional override for both import targets
#
# Import mapping: workspace = Templates | Releases; namespace folder = container id
# (default strategic-docs). Git granules/templates/releases are doc types, not Affine folders.
# CLI: yarn affine:import:templates --namespace strategic-docs --dry-run -- <path>

# Persistent paths on the VDS (layout: STRATEGY_AFFINE_DEPLOY.md)
DB_DATA_LOCATION=/opt/membrana-affine/postgres
UPLOAD_LOCATION=/opt/membrana-affine/storage
CONFIG_LOCATION=/opt/membrana-affine/config

# Database credentials — set a strong DB_PASSWORD before first `compose up`
DB_USERNAME=affine
DB_PASSWORD=
DB_DATABASE=affine
