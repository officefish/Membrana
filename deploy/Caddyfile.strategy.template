# Caddy v2 — production site block for strategy.mmbrn.tech (SAR W2 / #1159)
# Template: {{STRATEGY_DOMAIN}} / {{AFFINE_PORT}}
# → /etc/caddy/Caddyfile.d/strategy.caddy (рядом с office.caddy / panel.caddy).
# TLS: Let's Encrypt — только после DNS gate [go] (урок OM4-C).
# Не править office.caddy / panel.caddy; не дублировать import Caddyfile.d.

{{STRATEGY_DOMAIN}} {
	# socket.io lives at /socket.io/ (root), not /graphql. Caddy reverse_proxy
	# upgrades WebSocket by default; long-lived sync connections need open timeouts.
	@socketio path /socket.io/*
	handle @socketio {
		reverse_proxy 127.0.0.1:{{AFFINE_PORT}} {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	encode gzip
	reverse_proxy 127.0.0.1:{{AFFINE_PORT}} {
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
