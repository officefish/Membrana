# Зависимости
node_modules/

# Сборка
dist/
dist-demo/
build/
apps/membrana-studio/client-dist/
apps/membrana-studio/release/
*.tsbuildinfo
# Инкрементальные кэши TS с суффиксами (клиент: tsconfig.app / tsconfig.node)
**/.tsbuildinfo.*

# Кэш Turbo
.turbo/

# Покрытие тестов
coverage/

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Локальные дампы console (см. logs/README.md)
logs/apps/**/*
!logs/**/.gitignore
!logs/**/README.md

# Окружение
.env
.env.local
.env.*.local
**/.env.docker

# Локальные TLS-ключи (не коммитить)
ssl/

# Git worktrees (локальные, не коммитить)
.worktrees/

# MCP (локальные индексы и конфиги с ключами)
.gitnexus/
claude_desktop_config.json
docs/discussions/mcp-tier0.generated.json

# RAG (@membrana/rag-service) — LanceDB index + hash manifest (local only)
.membrana/rag/

# Ласточка: локальный ledger доставок (идемпотентность клиента)
.membrana/swallow-deliveries.jsonl
.membrana/infra-probe-latest.json

# Кеши контейнеров — рабочие файлы, не артефакты (зуб scripts/lib/container-cache-hygiene.mjs).
# Вещдок 28.07: docs/archivarius/cache/spans.jsonl — редактированные транскрипты сессий;
# git add -A утащил бы их в историю ПУБЛИЧНОГО репозитория.
docs/*/cache/

# Closure-review артефакты (manifest + <sha>-review.md) — локальные рабочие файлы
# процесса закрытия, НЕ часть публичного контракта репо (консилиум
# agent-tooling-friction 2026-07-13, ti-1). Историю чужих ревью не тянем в PR.
docs/reviews/*/

# Редакторы
.idea/
*.swp
.DS_Store
Thumbs.db

# Временные файлы
*.tmp
*.temp

# Случайный emit tsc в src (outDir должен быть dist/)
packages/services/detectors/**/src/*.js
packages/services/detectors/**/src/*.js.map
packages/services/detectors/**/src/*.d.ts
packages/services/detectors/**/src/*.d.ts.map

# Локальные SSH/debug-скрипты и вывод (не коммитить).
# ВНИМАНИЕ: паттерн ловит и переиспользуемые хелперы — все существующие
# scripts/_ssh-*.mjs трекаются, потому что были добавлены через `git add -f`.
# Новый _ssh-скрипт, который должен жить в репо, коммитить только так:
#   git add -f scripts/_ssh-<name>.mjs
# иначе он молча не войдёт в коммит (ретро #476 п.7).
scripts/_ssh-*.mjs
scripts/_*-out.txt

# Локальные логи deploy/recover в корне (Tee-Object при отладке VPS)
/cabinet-recover*.txt
/deploy-*.txt
/prod-check.txt

# Кэш загрузки внешних датасетов (WAV остаются в real-collection/)
docs/datasets/samples/.cache/

# Lockfile-ы других пакетных менеджеров (используем yarn.lock)
package-lock.json
pnpm-lock.yaml

# Yarn 4 (Berry) — служебные файлы.
# yarn.lock мы коммитим, всё остальное — нет.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# claude / cursor / continue — локальные каталоги AI IDE (не коммитить)
.claude/*
!.claude/CLAUDE.md
!.claude/skills/
!.claude/skills/**
!.claude/agents/
!.claude/agents/**
.continue/
.cursor/mcp.json

# SSL сертификаты для https соединений
ssl/

# LLM proxy secret (локальный, не коммитить никогда)
.env.llm-proxy
.env.llm-proxy.local

# Playwright / тестовые артефакты клиента
apps/client/playwright-report/
apps/client/test-results/

# Локальный дамп sync-readme (96 КБ, временный)
.sync-readme-out.txt

# Локальные бинари агентных инструментов (не коммитить)
tools/bin/*.exe
tools/bin/*.zip

# Vite HMR/esbuild временные конфиги (регенерируются; блокировали deploy preflight)
*.timestamp-*.mjs

# Python bytecode-кэш скриптов
__pycache__/
*.pyc

# Артефакт code-review --uncommitted (перезаписывается каждым прогоном → autostash-трение)
docs/discussions/uncommitted-code-review.md

# Артефакты code-review --pr/--branch (TF-3, #554): генерируются на каждое ревью и
# падали untracked — 16.07 после трёх PR-ревью пришлось git add поимённо, чтобы их
# не втянуть. Ревью-артефакт — процесс, а не исходник (тот же класс, что docs/reviews/).
docs/discussions/pr-*-code-review.md
docs/discussions/branch-*-code-review.md

# Артефакт yarn hermes:brief (генерируемый снимок состояния сессии, перезаписывается)
docs/HERMES_BRIEF.md

# Журнал drift-anchor (DA3 дайджесты + DA4/DA5 записи якорей) — локальный артефакт хоста (office/CI), не для репо
docs/reports/drift-anchor/
docs/tasks/morning-ritual-state.json

# Replit task briefs — транспорт (yarn replit:task), не канон; README + шаблон — в репо
docs/replit-tasks/*
!docs/replit-tasks/README.md
!docs/replit-tasks/_TEMPLATE.md


# Insight lifecycle runtime (C7 store/journal/lock)
docs/insights/_lifecycle/


# Worktree-гигиена (#717): карточка дерева и advisory-замок — per-tree, не версионируются
/WORKTREE.md
/.worktree-owner

# LPC evidence house — сырой кеш агента (не истина)
docs/audit/llm-calls/cache/**
!docs/audit/llm-calls/cache/.gitkeep

# Журнал рода «предсказание ↔ исход» — локальный вывод прогона.
# Настоящий дом записи — docs/virtual-team/memory/archive/<persona>.jsonl (провод адаптера,
# пока не построен). Стаб-вывод в репозитории = стаб, доживший до прода.
docs/sprint/experience/forecast-records.jsonl

# Дампы архивариуса: снимаются на ту же машину, в индекс не едут ни при каких условиях.
# Это данные пользователей, а не артефакт сборки — правило стоит здесь, а зуб на него
# в scripts/archivarius-dump.test.mjs, чтобы смена каталога не отменила правило молча.
var/backups/

# Носитель кадра night-report (#1293): локальная подтяжка артефакта ночи,
# свежесть по generatedAt — файл не коммитится, утро тянет его заново.
tests/reports/nightly-full/

# Дом network: транзит скрипта зондирования (В5 заседания network-container)
docs/audit/network/cache/
