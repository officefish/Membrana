#!/usr/bin/env sh
# Membrana pre-commit gate.
#
# 1) README↔registry tooth (M4D / #1063 / EPIC V7): только если в индексе
#    docs/tasks/registry.json или docs/tasks/README.md. Падает, не чинит.
# 2) gitleaks по staged (лист №5 security-posture / #1002).
#
# Пропустить (аварийно): SKIP_PRECOMMIT=1 git commit ...
if [ "$SKIP_PRECOMMIT" = "1" ]; then
  echo "pre-commit: пропущено (SKIP_PRECOMMIT=1)"
  exit 0
fi

# --- tasks README tooth (M4D) ---
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
if echo "$STAGED" | grep -qE '^docs/tasks/(registry\.json|README\.md)$'; then
  echo "pre-commit [tasks-readme]: yarn task:sync-readme --check"
  yarn task:sync-readme --check || exit $?
fi

# --- gitleaks (мягкий локально; зуб в CI) ---
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit [№5]: gitleaks не установлен — локальный секрет-скан пропущен (CI проверит)."
  echo "pre-commit: OK"
  exit 0
fi

echo "pre-commit [№5]: gitleaks protect --staged"
gitleaks protect --staged --no-banner --redact || exit $?
echo "pre-commit: OK"
