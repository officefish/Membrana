#!/usr/bin/env sh
# Membrana pre-push gate (cg6 + cg7, спринт tech-debt-2026-07).
#
# Ловит ДО push два локальных футгана, которые роняли CI:
#   cg7: новый плагин без записи в docs/catalog/client/registry.json
#        → catalog:verify-client красный.
#   cg6: stale dist соседнего пакета → одиночный typecheck ловит implicit-any.
#        yarn typecheck идёт через turbo (^build) → dist всегда свежий.
#
# CI уже защищён turbo ^build; хук лишь переносит эти проверки левее (до push),
# чтобы не узнавать о дыре из красного CI.
#
# Пропустить (аварийно): SKIP_PREPUSH=1 git push
if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "pre-push: пропущено (SKIP_PREPUSH=1)"
  exit 0
fi

set -e

# Свежее рабочее дерево без установленных зависимостей (#1272 Ф4).
# Эпизод 26.07: слияние делалось в отдельном дереве (общее держали чужие правки), и
# отправка оттуда падала невнятным «Couldn't find the node_modules state file» — вместо
# диагноза приходилось глушить весь хук (SKIP_PREPUSH). Проверки, которым нужен yarn,
# честно объявляются пропущенными; те, что работают на голом node, идут как обычно.
YARN_READY=1
if [ ! -d node_modules ]; then
  YARN_READY=0
  echo "pre-push [окружение]: зависимости не установлены (свежее рабочее дерево)."
  echo "  Пропущены проверки, которым нужен yarn: catalog:verify-client · kits:audit · typecheck."
  echo "  Гейт ответственности отработает — ему нужен только node."
  echo "  Полный набор: yarn install (или yarn worktree:bootstrap) в этом дереве."
fi

# Отказ-I «ответственный не назначен» (cowork-execution-registry, контракт §2/§6-б):
# карточка со status active без leadPersona → жёсткий вердикт 22, push не проходит.
# Гейт читает docs/tasks/registry.json офлайн; сети и yarn ему не нужно.
echo "pre-push [trace-gate]: node scripts/trace-gate.mjs lead-persona"
node scripts/trace-gate.mjs lead-persona

if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [cg7]: yarn catalog:verify-client"
  yarn catalog:verify-client
fi

# Описи китов (kits-pins-wiring / #1196): МЯГКИЙ режим — блокирует только структурную
# ложь (узел подграфа без пина), смену версии пропускает как warn. Строгая сверка —
# в CI (pinned). Без этого шага описи расходились молча: 25.07 накопилось 30 находок.
if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [kits]: yarn kits:audit --mode latest"
  yarn kits:audit --mode latest
fi

# Паритет секрет-гейта (#1262): pre-commit смотрит только индекс (`protect --staged`),
# а CI — `detect` по истории ВСЕХ ветвей (fetch-depth: 0). 26.07 синтетическая PEM-фикстура
# прошла локально, в CI стала находкой и покрасила заявку соседней сессии. Здесь тот же
# `detect` и тот же .gitleaksignore, но по диапазону origin/main..HEAD — объём не растёт
# с историей. Мягко при отсутствии gitleaks/базы; обход — SKIP_SECRET_GATE=1.
# Работает на голом node — флагом окружения не закрывается (#1272 Ф4).
echo "pre-push [#1262]: секрет-скан диапазона (тем же правилом, что CI)"
node scripts/secret-gate-push.mjs

if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [NB4]: yarn verify:wire-sync (core ↔ background-cabinet)"
  yarn verify:wire-sync
fi

# NB5: typecheck сужен до affected-пакетов (изменённые с origin/main + их зависимые),
# turbo ^build держит dist свежим. Быстрее полного прогона → меньше соблазна SKIP.
# #1168: вычисление affected ИСКЛЮЧАЕТ .md/.mdx (docs не влияют на типы) — иначе markdown
# внутри пакета поднимал его билд-цепочку (vite 127 на telemetry-journal). Логика — в скрипте
# (origin/main недоступен → полный; docs-only/корневые скрипты → skip; корневой конфиг → полный).
if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [cg6/NB5]: typecheck (affected без docs-триггера)"
  node scripts/prepush-typecheck-scope.mjs
fi

echo "pre-push: OK"
