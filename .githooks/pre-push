#!/usr/bin/env sh
# Membrana pre-push gate (cg6 + cg7, спринт tech-debt-2026-07).
#
# Ловит ДО push два локальных футгана, которые роняли CI:
#   cg7: новый плагин без записи в docs/catalog/client/registry.json
#        → catalog:verify-client красный.
#   cg6: stale dist соседнего пакета → одиночный typecheck ловит implicit-any.
#        yarn typecheck идёт через turbo (^build) → dist всегда свежий.
#
# CI уже защищён turbo ^build; хук лишь переносит эти проверки левее (до push),
# чтобы не узнавать о дыре из красного CI.
#
# ПОРЯДОК ШАГОВ — ЧАСТЬ КОНТРАКТА (#2495, 28.09). Секрет-скан #1262 идёт ПЕРВЫМ, потому
# что при `set -e` любой шаг выше ВЫТЕСНЯЕТ всё, что ниже. До 28.09 он стоял восьмым,
# а шестым — зуб сети, краснеющий по КАЛЕНДАРЮ (снимок docs/network/env.snapshot.json
# старше 48 ч). Замер 28.09: `set -e; node scripts/network/tooth.mjs; <секрет-скан>` со
# снимком от 25.09 до секрет-скана не доходил. Второй путь того же: календарный отказ
# зуба сети своего выключателя не имел, и человека отправляли к общему SKIP_PREPUSH=1 —
# который гасит секрет-скан, гейт ответственности, kits-strict и typecheck заодно.
# Починка #2495: уход за снимком в предпуше объявлен предупреждением (ключ
# --snapshot-upkeep=warn), нового выключателя не заведено — обход не нужен там, где нет
# отказа. Оба свойства держит зуб scripts/prepush-secret-gate-reach.test.mjs.
#
# Пропустить (аварийно, целиком): SKIP_PREPUSH=1 git push
if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "pre-push: пропущено (SKIP_PREPUSH=1)"
  exit 0
fi

set -e

# #1232 Ф2: отправка с HEAD == main запрещена (мимо заявки / ALLOW_MAIN_COMMIT=1).
branch=$(git branch --show-current 2>/dev/null || true)
if [ "$branch" = "main" ] && [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
  echo "pre-push: HEAD == main — push запрещён (#1232). Обход: ALLOW_MAIN_COMMIT=1" >&2
  exit 1
fi

# Свежее рабочее дерево без установленных зависимостей (#1272 Ф4).
# Эпизод 26.07: слияние делалось в отдельном дереве (общее держали чужие правки), и
# отправка оттуда падала невнятным «Couldn't find the node_modules state file» — вместо
# диагноза приходилось глушить весь хук (SKIP_PREPUSH). Проверки, которым нужен yarn,
# честно объявляются пропущенными; те, что работают на голом node, идут как обычно.
YARN_READY=1
if [ ! -d node_modules ]; then
  YARN_READY=0
  echo "pre-push [окружение]: зависимости не установлены (свежее рабочее дерево)."
  echo "  Пропущены проверки, которым нужен yarn: catalog:verify-client · kits:audit · typecheck."
  echo "  Гейт ответственности отработает — ему нужен только node."
  echo "  Полный набор: yarn install (или yarn worktree:bootstrap) в этом дереве."
fi

# Паритет секрет-гейта (#1262): pre-commit смотрит только индекс (`protect --staged`),
# а CI — `detect` по истории ВСЕХ ветвей (fetch-depth: 0). 26.07 синтетическая PEM-фикстура
# прошла локально, в CI стала находкой и покрасила заявку соседней сессии. Здесь тот же
# `detect` и тот же .gitleaksignore, но по диапазону origin/main..HEAD — объём не растёт
# с историей. Мягко при отсутствии gitleaks/базы; обход — SKIP_SECRET_GATE=1.
# Работает на голом node — флагом окружения не закрывается (#1272 Ф4).
#
# ИДЁТ ПЕРВЫМ (#2495). До 28.09 он стоял восьмым, и при `set -e` любой шаг выше его
# ВЫТЕСНЯЛ: протухший по календарю снимок сети давал exit 1 на шаге #1449, и секрет-скан
# в этом прогоне не запускался вообще. Замерено 28.09: `set -e; node scripts/network/tooth.mjs;
# <секрет-скан>` со снимком от 25.09 — до секрет-скана управление не дошло. Жёсткая граница
# не может зависеть от порядка и от календаря постороннего файла, поэтому она идёт до всего
# остального. Порядок держит зуб scripts/prepush-secret-gate-reach.test.mjs.
echo "pre-push [#1262]: секрет-скан диапазона (тем же правилом, что CI)"
node scripts/secret-gate-push.mjs

# Отказ-I «ответственный не назначен» (cowork-execution-registry, контракт §2/§6-б):
# карточка со status active без leadPersona → жёсткий вердикт 22, push не проходит.
# Гейт читает docs/tasks/registry.json офлайн; сети и yarn ему не нужно.
echo "pre-push [trace-gate]: node scripts/trace-gate.mjs lead-persona"
node scripts/trace-gate.mjs lead-persona

if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [cg7]: yarn catalog:verify-client"
  yarn catalog:verify-client
fi

# Описи китов (kits-pins-wiring / #1196): МЯГКИЙ режим — блокирует только структурную
# ложь (узел подграфа без пина), смену версии пропускает как warn. Строгая сверка —
# в CI (pinned). Без этого шага описи расходились молча: 25.07 накопилось 30 находок.
if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [kits]: yarn kits:audit --mode latest"
  yarn kits:audit --mode latest
fi

# kits-pins-prepush-strict (friction-6): СТРОГАЯ сверка только китов, чьи запиненные
# файлы затронуты пушем — дрейф ловится за секунду локально, а не за 5 минут CI
# (26.07: lens-bestiary развёл witcher, _main-day-issue — angelina-morning; красный
# main красил PR всех сессий). Пустой прогон — чтение манифестов + один git diff.
# Голый node, ремонт называется точной командой перепина.
echo "pre-push [kits-strict]: node scripts/kits-prepush-strict.mjs"
node scripts/kits-prepush-strict.mjs

# Зуб контейнера сети (#1449): словарь исходов закрыт, в серверном коде нет голого fetch
# мимо HTTPS_PROXY, снимок на месте и читается. Прямой путь по ратифицированному решению
# (метка allow-bare-fetch + живой ADR) находкой не считается. Голый node; ремонт зуб
# называет сам.
#
# УХОД ЗА СНИМКОМ ЗДЕСЬ — ПРЕДУПРЕЖДЕНИЕ, НЕ ОТКАЗ (#2495; история — в шапке файла).
# Снимок лежит в репозитории и протухает по КАЛЕНДАРЮ: с некоторого часа суток отказ
# приходил ВСЕМ деревьям сразу, на файле, к правке не относящемся (27.09: PR #2489 не
# трогал docs/network/ вовсе, 48 ч истекли в 13:34Z, в 14:07Z push стал невозможен).
#
# Свойство «воспоминание не выдаёт себя за факт» отказом push и не держалось: пометку
# «устарел (>48 ч)» ставят читающие снимок — renderAgentBlock и renderSnapshotMd
# (scripts/network/lib/probe-core.mjs). Жёстко уход судится там, где снимок и есть
# предмет: прямой `yarn network:tooth` (ритуал, разбор) — режим по умолчанию.
# Побочно снят задокументированный в .gitattributes повод: требование свежести ПЕРЕД push
# и заставляло каждую ветку писать снимок, отчего лента 09.09 конфликтовала у всех подряд.
echo "pre-push [#1449]: node scripts/network/tooth.mjs --snapshot-upkeep=warn"
node scripts/network/tooth.mjs --snapshot-upkeep=warn

# Зуб политики машин (#1912, В7 заседания network-container, ратифицирован 13.08):
# голый fetch в серверной зоне без proxy-обвязки и без записи-исключения в
# docs/audit/network/registry/machine-policy.json. Warn-храповик: легаси в бюджете
# зелёные и названы, новое сверх бюджета — красный. Исключения ТОЛЬКО данными
# (метка в коде не считается — В7). Голый node. Старый bare-подблок tooth.mjs выше
# (метка allow-bare-fetch, зона только office) — предшественник, вывод из
# эксплуатации отдельным ходом; двойная проверка безвредна: этот зуб строже.
echo "pre-push [#1912]: node scripts/check-bare-fetch.mjs"
node scripts/check-bare-fetch.mjs

if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [NB4]: yarn verify:wire-sync (core ↔ background-cabinet)"
  yarn verify:wire-sync
fi

# NB5: typecheck сужен до affected-пакетов (изменённые с origin/main + их зависимые),
# turbo ^build держит dist свежим. Быстрее полного прогона → меньше соблазна SKIP.
# #1168: вычисление affected ИСКЛЮЧАЕТ .md/.mdx (docs не влияют на типы) — иначе markdown
# внутри пакета поднимал его билд-цепочку (vite 127 на telemetry-journal). Логика — в скрипте
# (origin/main недоступен → полный; docs-only/корневые скрипты → skip; корневой конфиг → полный).
if [ "$YARN_READY" = "1" ]; then
  echo "pre-push [cg6/NB5]: typecheck (affected без docs-триггера)"
  node scripts/prepush-typecheck-scope.mjs
fi

echo "pre-push: OK"
