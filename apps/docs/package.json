{
  "name": "@membrana/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Membrana Product documentation (Mintlify): Device Board, nodes and tariffs. Harness lives separately.",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "dev": "node ../../scripts/docs-dev.mjs --root apps/docs",
    "build": "node ../../scripts/product-docs-tariffs.mjs --check && node ../../scripts/verify-mintlify-docs.mjs --root apps/docs",
    "lint": "node ../../scripts/product-docs-tariffs.mjs --check && node ../../scripts/verify-mintlify-docs.mjs --root apps/docs --links",
    "clean": "rimraf .mintlify",
    "typecheck": "echo \"@membrana/docs: no TypeScript\"",
    "test": "echo \"@membrana/docs: no unit tests\""
  },
  "devDependencies": {
    "mintlify": "^4.2.123",
    "rimraf": "^5.0.0"
  }
}
